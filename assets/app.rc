1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", AUTHOR_STR
      VALUE "FileDescription", DESC_STR
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "mem_guard"
      VALUE "LegalCopyright", "(c) yee58767"
      VALUE "OriginalFilename", "mem_guard.exe"
      VALUE "ProductName", DESC_STR
      VALUE "ProductVersion", VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
